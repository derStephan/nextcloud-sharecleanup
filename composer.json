{
    "name": "derstephan/sharecleanup",
    "description": "Nextcloud app that automatically ends file shares after a configurable period",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OCA\\ShareCleanup\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\ShareCleanup\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
